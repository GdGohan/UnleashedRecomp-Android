<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary button of the launcher and mod screens (matches LauncherActivity.button()). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F232A" />
            <stroke android:width="1dp" android:color="#2A2E35" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</ripple>
